{
  "plugins": [
    {
      "id": "secrets",
      "type": "scanner",
      "script": "plugins/secrets/scanner.py",
      "timeout_seconds": 300,
      "output_file": "secrets.txt",
      "dependencies": {
        "apt": [],
        "pip": []
      },
      "config": {
        "timeout": "300"
      },
      "agent_module": "/app/analysis/plugins/secrets/agent.py",
      "agent_description": "Analyses secrets.txt to identify hardcoded secrets and credentials found by Gitleaks. Pass the path to the scan directory.\n",
      "trigger": {
        "type": "always",
        "matched": true
      }
    },
    {
      "id": "semgrep",
      "type": "scanner",
      "script": "plugins/semgrep/scanner.py",
      "timeout_seconds": 300,
      "output_file": "semgrep.txt",
      "dependencies": {
        "apt": [],
        "pip": []
      },
      "config": {
        "timeout": "300"
      },
      "agent_module": "/app/analysis/plugins/semgrep/agent.py",
      "agent_description": "Analyses semgrep.txt to identify security vulnerabilities found by Semgrep static analysis. Pass the path to the scan directory.\n",
      "trigger": {
        "type": "always",
        "matched": true
      }
    },
    {
      "id": "cdknag",
      "type": "scanner",
      "script": "plugins/cdknag/scanner.py",
      "timeout_seconds": 300,
      "output_file": "cdknag.txt",
      "dependencies": {
        "apt": [],
        "pip": []
      },
      "config": {
        "timeout": "300"
      },
      "agent_module": "/app/analysis/plugins/cdknag/agent.py",
      "agent_description": "Analyses cdknag.txt to identify AWS CDK security best practice violations found by CDK NAG. Pass the path to the scan directory.\n",
      "trigger": {
        "type": "conditional",
        "matched": true,
        "file_patterns": [
          "cdk.json",
          "**/cdk.json"
        ]
      }
    },
    {
      "id": "cfnnag",
      "type": "scanner",
      "script": "plugins/cfnnag/scanner.py",
      "timeout_seconds": 300,
      "output_file": "cfnnag.txt",
      "dependencies": {
        "apt": [],
        "pip": []
      },
      "config": {
        "timeout": "300"
      },
      "agent_module": "/app/analysis/plugins/cfnnag/agent.py",
      "agent_description": "Analyses cfnnag.txt to identify security issues in CloudFormation templates found by cfn-nag. Pass the path to the scan directory.\n",
      "trigger": {
        "type": "conditional",
        "matched": true,
        "file_patterns": [
          "*.template",
          "**/*.template",
          "template.json",
          "template.yaml"
        ]
      }
    },
    {
      "id": "bandit",
      "type": "scanner",
      "script": "plugins/bandit/scanner.py",
      "timeout_seconds": 300,
      "output_file": "bandit.txt",
      "dependencies": {
        "apt": [],
        "pip": []
      },
      "config": {
        "timeout": "300"
      },
      "agent_module": "/app/analysis/plugins/bandit/agent.py",
      "agent_description": "Analyses bandit.txt to identify security issues found by Bandit in Python source code. Pass the path to the scan directory.\n",
      "trigger": {
        "type": "conditional",
        "matched": true,
        "file_patterns": [
          "*.py",
          "**/*.py"
        ]
      }
    },
    {
      "id": "checkov",
      "type": "scanner",
      "script": "plugins/checkov/scanner.py",
      "timeout_seconds": 300,
      "output_file": "checkov.txt",
      "dependencies": {
        "apt": [],
        "pip": []
      },
      "config": {
        "timeout": "300"
      },
      "agent_module": "/app/analysis/plugins/checkov/agent.py",
      "agent_description": "Analyses checkov.txt to identify infrastructure security issues found by Checkov. Pass the path to the scan directory.\n",
      "trigger": {
        "type": "conditional",
        "matched": true,
        "file_patterns": [
          "*.tf",
          "**/*.tf",
          "*.tf.json",
          "**/*.tf.json",
          "*.template",
          "**/*.template",
          "template.json",
          "template.yaml",
          "*.cfn.yaml",
          "**/*.cfn.yaml",
          "*.cfn.json",
          "**/*.cfn.json",
          "Chart.yaml",
          "**/Chart.yaml",
          "Dockerfile",
          "**/Dockerfile",
          "Containerfile",
          "**/Containerfile",
          "serverless.yml",
          "**/serverless.yml",
          "*.bicep",
          "**/*.bicep",
          "azuredeploy.json",
          "**/azuredeploy.json",
          "cdk.json",
          "**/cdk.json"
        ]
      }
    },
    {
      "id": "cve",
      "type": "scanner",
      "script": "plugins/cve/scanner.py",
      "timeout_seconds": 600,
      "output_file": "cve",
      "dependencies": {
        "apt": [],
        "pip": []
      },
      "config": {
        "timeout": "300"
      },
      "agent_module": "/app/analysis/plugins/cve/agent.py",
      "agent_description": "Analyses the cve/ directory to identify known CVEs in project dependencies found by osv-scanner across Python, Node.js, Java, and Go dependency manifests and lock files. Pass the path to the scan directory.\n",
      "trigger": {
        "type": "always",
        "matched": true
      }
    },
    {
      "id": "license-headers",
      "type": "scanner",
      "script": "plugins/license-headers/scanner.py",
      "timeout_seconds": 120,
      "output_file": "license_headers.txt",
      "dependencies": {
        "apt": [],
        "pip": []
      },
      "config": {
        "license_text": "Apache 2.0",
        "timeout": "120"
      },
      "agent_module": "/app/analysis/plugins/license-headers/agent.py",
      "agent_description": "Analyses license_headers.txt to check for license header compliance in source files. Pass the path to the scan directory.\n",
      "trigger": {
        "type": "always",
        "matched": true
      }
    },
    {
      "id": "iam-least-privilege",
      "type": "agentic",
      "config": {},
      "agent_module": "/app/analysis/plugins/iam-least-privilege/agent.py",
      "agent_description": "Inspects the project source for IAM policy documents (standalone JSON, CDK/CloudFormation/Terraform-embedded, and inline/SDK-constructed) and judges them against least-privilege principles. Run against the project source directory.\n",
      "trigger": {
        "type": "always",
        "matched": true
      }
    }
  ],
  "actions": [
    {
      "id": "markdown-report",
      "module": "/app/plugins/markdown-report/action.py",
      "description": "Generates an executive summary from all scanner detail files, replaces the Summary by Tool table with deterministic values, strips duplicate sections, normalizes headings, and assembles the final markdown report.\n",
      "accepts": [
        "findings",
        "detail_files",
        "summary"
      ],
      "produces": [
        "markdown_report"
      ],
      "config": {
        "report_filename": "summary.md"
      }
    }
  ]
}